{
  "_comment": [
    "Recode table of the IBGE Census 1991 sample microdata (CD91AMOUP<UF>.DBF) for T1.",
    "Built from the profile (censo_1991/profile_report) and the dictionary; review before use.",
    "Per variable: name (V + section + item of the dictionary number), layer, class, map (source value -> T1 value) and notes.",
    "Unmapped values are kept as they are. A blank cell becomes the 'blank' value (default -9999) unless the variable says otherwise.",
    "Classes: quantity (real values), boolean (1 yes / 0 no), categorical (IBGE codes; labels in CATEGORIES), code / identifier (keys), text (dropped: names come from the DTB)."
  ],
  "flags": {
    "-9999": "nao aplicavel (NSA) / sem dado",
    "-2": "ignorado ou nao sabe"
  },
  "defaults": {
    "blank": -9999
  },
  "derived": {
    "municipio_code": "codigo DTB de 7 digitos cujo prefixo de 6 digitos = UFNUM + MUNICNUM (4 digitos)",
    "household_code": "municipio_code + sequencial de 6 digitos por municipio, atribuido uma vez a partir dos blocos (PESSOAN = 1 inicia o domicilio) com as verificacoes como parada obrigatoria; depois a ordem nao importa",
    "person_code": "household_code + PESSOAN (2 digitos)",
    "situacao_type": "Urbana (situacao_code 1-3) / Rural (4-8)",
    "municipioanterior_code": "MIANTEUF (11-53) + MIANTEMU (<> 0000) conferido com o DTB; senao NA",
    "municipio1986_code": "MIMO86UF (11-53) + MIMO86MU conferido com o DTB; MIMO86UF = 70 usa o municipio_code atual; senao NA"
  },
