{
  "report_folder": "suite_report",
  "config_suffix": "example",
  "_order": "dtb first (the census geography_from_dtb steps read DTB T1); pop after dtb; pnsb_<year> and atlassan after dtb (they read the DTB municipal list); censo_2000 before censo_1991 (1991 geography reads 2000 T1); checks last. The dtb / pop copy steps take files of the census 2022 T1.",
  "pipelines": {
    "dtb": [
      {
        "copy": "/path/to/IBGE/CENSO-2022/V300/T1/ASSETS/IBGE_CENSO-2022_SEDES_BRASIL_2022.gpkg",
        "to": "/path/to/IBGE/DTB/V100/SRC/DTB_2022"
      },
      {
        "run": "dtb/assemble_tables.py"
      },
      {
        "run": "dtb/assemble_geography.py"
      },
      {
        "run": "dtb/build_lineage.py"
      },
      {
        "run": "dtb/plot_lineage.py"
      },
      {
        "copy": "dtb/IBGE_DTB_LAYERS_X_X.csv",
        "to": "/path/to/IBGE/DTB/V100/T1/ASSETS"
      },
      {
        "run": "censos/package_t1.py",
        "config": "package_t1_dtb",
        "overwrite": false
      },
      {
        "run": "dtb/build_database_dtb.py"
      },
      {
        "run": "dtb/check_visuals.py"
      }
    ],
    "pop": [
      {
        "copy": "/path/to/IBGE/CENSO-2022/V300/T1/ASSETS/IBGE_CENSO-2022_BASICO_BRASIL_2022.csv",
        "to": "/path/to/IBGE/POP/V100/SRC"
      },
      {
        "run": "pop/assemble_population.py"
      },
      {
        "copy": "pop/IBGE_POP_LAYERS_X_X.csv",
        "to": "/path/to/IBGE/POP/V100/T1/ASSETS"
      },
      {
        "run": "pop/check_visuals.py"
      },
      {
        "run": "censos/package_t1.py",
        "config": "package_t1_pop",
        "overwrite": false
      },
      {
        "run": "pop/build_database_pop.py"
      }
    ],
    "pnsb_2017": [
      {
        "run": "pnsb/download_pnsb.py",
        "config": "download_pnsb_2017",
        "optional": true
      },
      {
        "run": "pnsb/assemble_pnsb.py",
        "config": "assemble_pnsb_2017"
      },
      {
        "run": "censos/geography_from_dtb_editions.py",
        "config": "geography_pnsb_2017"
      },
      {
        "copy": "pnsb/IBGE_PNSB-2017_LAYERS_X_X.csv",
        "to": "/path/to/IBGE/PNSB-2017/V100/T1/ASSETS"
      },
      {
        "copy": "pnsb/IBGE_PNSB-2017_FIELDS_X_X.csv",
        "to": "/path/to/IBGE/PNSB-2017/V100/T1/ASSETS"
      },
      {
        "run": "censos/build_database_tables.py",
        "config": "build_database_pnsb_2017"
      },
      {
        "run": "censos/package_t1.py",
        "config": "package_t1_pnsb_2017",
        "overwrite": false
      }
    ],
    "pnsb_2008": [
      {
