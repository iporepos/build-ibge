  "report_folder": "package_report",
  "prefix": "IBGE_POP",
  "bundles": {
    "IBGE_POP_CENSOS-MUNICIPIOS_BRASIL_{YEARS}.zip": [
      "IBGE_POP_CENSOS-MUNICIPIOS_BRASIL_[0-9][0-9][0-9][0-9].csv"
    ],
    "IBGE_POP_ESTIMATIVAS-MUNICIPIOS_BRASIL_{YEARS}.zip": [
      "IBGE_POP_ESTIMATIVAS-MUNICIPIOS_BRASIL_[0-9][0-9][0-9][0-9].csv"
    ],
    "IBGE_POP_ESTIMATIVAS-UNIDADES_BRASIL_{YEARS}.zip": [
      "IBGE_POP_ESTIMATIVAS-UNIDADES_BRASIL_[0-9][0-9][0-9][0-9].csv"
    ],
    "IBGE_POP_ESTIMATIVAS-NOTAS_BRASIL_{YEARS}.zip": [
      "IBGE_POP_ESTIMATIVAS-NOTAS_BRASIL_[0-9][0-9][0-9][0-9].csv"
