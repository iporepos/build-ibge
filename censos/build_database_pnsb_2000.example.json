{
  "input_folder": "/path/to/IBGE/PNSB-2000/V100/T1/ASSETS",
  "output_folder": "/path/to/IBGE/PNSB-2000/V100/T2/ASSETS",
  "output_name": "IBGE_PNSB-2000_BD_BRASIL_2000.gpkg",
  "report_folder": "database_report",
  "data_pattern": "IBGE_PNSB-2000_T(?P<code>\\d+)_BRASIL_2000\\.csv",
  "layer_template": "t{code}",
  "layers_catalog": "IBGE_PNSB-2000_LAYERS_X_X.csv",
  "fields_catalog": "IBGE_PNSB-2000_FIELDS_X_X.csv",
  "keys": [
    "municipio_code"
  ],
  "field_patterns": {
    "v\\d+(_\\d+)*": "v<variável>_<categoria>..."
  },
  "geo_pattern": "IBGE_PNSB-2000_GEO-(?P<name>[A-Z]+)_BRASIL_2000\\.gpkg",
  "geo_template": "ibge_dtb_{name}_2000",
  "geo_lookup": "ibge_dtb_{name}_2000"
}
