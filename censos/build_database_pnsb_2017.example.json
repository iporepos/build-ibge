{
  "input_folder": "/path/to/IBGE/PNSB-2017/V1/T1/ASSETS",
  "output_folder": "/path/to/IBGE/PNSB-2017/V1/T2/ASSETS",
  "output_name": "IBGE_PNSB-2017_BD_BRASIL_2017.gpkg",
  "report_folder": "database_report",
  "data_pattern": "IBGE_PNSB-2017_T(?P<code>\\d+)_BRASIL_2017\\.csv",
  "layer_template": "t{code}",
  "layers_catalog": "IBGE_PNSB-2017_LAYERS_X_X.csv",
  "fields_catalog": "IBGE_PNSB-2017_FIELDS_X_X.csv",
  "keys": [
    "municipio_code"
  ],
  "field_patterns": {
    "v\\d+(_\\d+)*": "v<variável>_<categoria>..."
  },
  "geo_pattern": "IBGE_PNSB-2017_GEO-(?P<name>[A-Z]+)_BRASIL_2017\\.gpkg",
  "geo_template": "ibge_dtb_{name}_2017",
  "geo_lookup": "ibge_dtb_{name}_2017"
}
